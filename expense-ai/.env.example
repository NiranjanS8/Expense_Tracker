# Copy to .env and fill in real values. Never commit .env.
# This file contains placeholders only.

# --- Service ---
APP_ENV=local
LOG_LEVEL=INFO

# --- Upstream Spring Boot API ---
EXPENSE_TRACKER_BASE_URL=http://localhost:9090
EXPENSE_TRACKER_CONTEXT_PATH=/api
EXPENSE_TRACKER_TIMEOUT_SECONDS=5
# Retries apply only to transport failures and 502/503/504; 4xx is never retried.
EXPENSE_TRACKER_MAX_RETRIES=1
EXPENSE_TRACKER_RETRY_BACKOFF_SECONDS=0.25

# --- Identity (Option A: introspection via GET /users/me) ---
IDENTITY_CACHE_TTL_SECONDS=60

# --- AI-owned persistence (PostgreSQL) ---
# Conversation state lives in its own database, never the financial schema.
# Spring Boot is still the only route to financial data.
DATABASE_URL=postgresql+asyncpg://expense_ai:expense_ai@localhost:5432/expense_ai
DATABASE_ECHO=false
# Alembic owns the schema: run `uv run alembic upgrade head`. Leave this false
# outside tests; tests build an in-memory SQLite schema instead.
AUTO_CREATE_SCHEMA=false

# --- Agent bounds and conversation limits ---
AGENT_MAX_TOOL_CALLS=3
AGENT_RECURSION_LIMIT=40
AGENT_HISTORY_MESSAGES=12
CONVERSATION_LIST_LIMIT=50
CONVERSATION_MESSAGE_LIMIT=200
CONVERSATION_TITLE_MAX_LENGTH=80

# --- Request limits ---
MAX_REQUEST_BYTES=32768
CHAT_RATE_LIMIT_PER_MINUTE=20

# --- CORS (JSON array) ---
CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# --- LLM provider selection: openai | anthropic | mistral | deepseek | gemini | fake ---
LLM_PROVIDER=fake
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_BACKOFF_SECONDS=0.5
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=1024

# Provider credentials (only the selected provider's key is required).
# Claude is served through the "anthropic" provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_BASE_URL=https://api.mistral.ai/v1

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
