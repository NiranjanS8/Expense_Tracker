{
  "version": 1,
  "description": "Representative read-only assistant prompts with the tool choice, grounding evidence and answer behaviour each one must produce. Model steps are scripted so the suite is deterministic and offline; Spring Boot is stubbed by the runner.",
  "cases": [
    {
      "id": "spending-this-month",
      "category": "straightforward_spending",
      "prompt": "How much did I spend this month?",
      "intent": "data",
      "upstream": [
        {
          "path": "/api/expenses/summary",
          "status": 200,
          "body": {
            "totalAmount": "120.00",
            "transactionCount": 4,
            "startDate": "2026-10-01",
            "endDate": "2026-10-31"
          }
        }
      ],
      "model": [
        {
          "tool_call": {
            "name": "get_spending_summary",
            "arguments": { "start_date": "2026-10-01", "end_date": "2026-10-31" }
          }
        },
        { "answer": "You spent 120.00 across 4 transactions this month." }
      ],
      "expect": {
        "tool_calls": ["get_spending_summary"],
        "termination": "answered",
        "answer_contains": ["120.00"],
        "grounding_evidence": ["120.00"],
        "upstream_paths": { "/api/expenses/summary": 1 }
      }
    },
    {
      "id": "largest-expenses",
      "category": "similar_category_names",
      "prompt": "Show my five largest expenses this month.",
      "intent": "data",
      "upstream": [
        {
          "path": "/api/expenses",
          "status": 200,
          "body": {
            "content": [
              {
                "id": 1,
                "categoryId": 5,
                "categoryName": "Food",
                "amount": "42.50",
                "expenseDate": "2026-10-05",
                "description": "Lunch",
                "paymentMethod": "CARD"
              }
            ],
            "page": 0,
            "size": 5,
            "totalElements": 1,
            "totalPages": 1,
            "last": true
          }
        }
      ],
      "model": [
        {
          "tool_call": {
            "name": "search_expenses",
            "arguments": { "start_date": "2026-10-01", "end_date": "2026-10-31", "size": 5 }
          }
        },
        { "answer": "Your largest expense was 42.50 on Food." }
      ],
      "expect": {
        "tool_calls": ["search_expenses"],
        "termination": "answered",
        "answer_contains": ["42.50"],
        "grounding_evidence": ["42.50"],
        "upstream_paths": { "/api/expenses": 1 }
      }
    },
    {
