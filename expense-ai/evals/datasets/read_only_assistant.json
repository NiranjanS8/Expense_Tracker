          }
        },
        { "answer": "You spent 42.50 on Food this month." }
      ],
      "expect": {
        "tool_calls": ["get_category_breakdown"],
        "termination": "answered",
        "answer_contains": ["42.50"],
        "grounding_evidence": ["42.50"],
        "upstream_paths": { "/api/dashboard/categories": 1 }
      }
    },
