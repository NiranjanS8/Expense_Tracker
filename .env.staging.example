# Copy to .env.staging and replace every placeholder before starting the stack.
# Never commit .env.staging.
#
#   docker compose -f compose.staging.yaml --env-file .env.staging up --build
#
# Compose does not support inline comments in env files, so every comment here
# sits on its own line.

# --- Financial database (Spring Boot's own PostgreSQL) ---
FINANCIAL_DB_NAME=expense_tracker
FINANCIAL_DB_USERNAME=postgres
# REQUIRED
FINANCIAL_DB_PASSWORD=change-me-financial-db

# Hibernate schema management for this disposable staging database. Set to
# `validate` for any database whose schema is managed outside the application.
JPA_DDL_AUTO=update

# Loads the demo user and sample expenses on startup. Set to false for a
# database that must not be seeded.
APP_SEED_ENABLED=true

# --- Spring Boot identity ---
# REQUIRED. Signing key for the access tokens the assistant introspects.
JWT_SECRET=change-me-to-a-long-random-secret

# --- Assistant persistence (its own PostgreSQL, never the financial schema) ---
AI_DB_NAME=expense_ai
AI_DB_USERNAME=expense_ai
# REQUIRED
AI_DB_PASSWORD=change-me-ai-db

# --- Assistant model provider ---
# `fake` answers deterministically with no credentials and no network calls, so
# this stack can be rehearsed offline. Set a real provider plus its key to get
# real answers.
LLM_PROVIDER=fake
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# --- Assistant observability ---
# /metrics is bound to loopback only and gated behind this flag.
METRICS_ENABLED=true

# Tracing exports prompts and retrieved financial figures to a third party.
# Leave off unless the endpoint is approved for that data.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=

# --- Published ports ---
# The SPA is the only port reachable by users.
FRONTEND_PORT=8081
# Loopback binding for the assistant's own readiness and metrics endpoints.
AI_PORT=18080
